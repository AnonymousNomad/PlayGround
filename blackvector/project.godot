; Engine configuration file.
; BLACK VECTOR — Independent Benchmark (Godot 4.7.2, GL Compatibility)

config_version=5

[application]

config/name="BLACK VECTOR BENCHMARK"
config/description="BLACK VECTOR independent benchmark vertical slice: third-person survival/stealth on Vesper island."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/version="0.1.0-benchmark"
boot_splash/bg_color=Color(0.05, 0.07, 0.09, 1)

[android]

package/unique_name="com.blackvector.benchmark"
package/name="BlackVectorBenchmark"
package/signed=false
package/app_category=2
package/orientation=0
package/exclude_from_recents=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/shadow_opacity=0.55
environment/defaults/default_clear_color=Color(0.55, 0.65, 0.72, 1)
 limits/global_shader_variables=64

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":87,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null), Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"axis":1,"axis_value":-1.0,"script":null)]
}
